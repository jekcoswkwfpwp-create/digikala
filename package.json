{
  "scripts": {
    "compile:sass": "sass scss/main.scss public/css/style.css -w",
    "prefix:css": "postcss --use autoprefixer -b \"last 10 versions\" public/css/style.css -o public/css/style.prefix.css",
    "compress:css": "sass public/css/style.prefix.css public/css/style.min.css --style=compressed",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "sass": "1.77.8"
  }
}
